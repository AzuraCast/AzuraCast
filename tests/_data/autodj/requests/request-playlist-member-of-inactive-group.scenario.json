      "now": "2026-11-02T19:00:00+00:00",
      "runtime": {
        "requests": [
          {
            "media_ref": "m4",
            "skip_delay": true
          }
        ]
      },
      "expect_sequence": [
        {
          "mode": "exact",
          "media_ref": "m4",
          "from_request": true,
          "playlist_chain_refs": [],
