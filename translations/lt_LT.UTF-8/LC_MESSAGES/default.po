#: frontend/components/Admin/Index/DiskUsagePanel.vue:33
#: frontend/components/Admin/Index/MemoryStatsHelpModal.vue:34
#: frontend/components/Admin/Index/MemoryStatsPanel.vue:48
msgid "Used"
msgstr "Naudojama"

#: frontend/components/Admin/Index/MemoryStatsHelpModal.vue:7
msgid "Memory Stats Help"
msgstr "Atminties statistikos pagalba"

#: frontend/components/Admin/Index/MemoryStatsHelpModal.vue:13
#: frontend/components/Admin/Index/MemoryStatsPanel.vue:54
msgid "Cached"
msgstr "Talpykla (Cached)"

#: frontend/components/Admin/Index/MemoryStatsHelpModal.vue:14
msgid "The amount of memory Linux is using for disk caching."
msgstr "Atminties kiekis, kurį „Linux“ naudoja disko talpyklai."

#: frontend/components/Admin/Index/MemoryStatsHelpModal.vue:19
msgid "This can make it look like your memory is low while it actually is not. Some monitoring solutions/panels include cached memory in their used memory statistics without indicating this."
